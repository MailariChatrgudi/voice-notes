OPENROUTER_API_KEY=


# Safest free default: OpenRouter chooses an available free model.
OPENROUTER_MODEL=openrouter/free

# Optional Google/Gemini-family experiments. Use one only if OpenRouter still lists it.
# OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_APP_TITLE=AI Voice Notes Action Items

# Used only when transcribing audio with faster-whisper.
WHISPER_MODEL=base
VOICE_LANGUAGE=en
